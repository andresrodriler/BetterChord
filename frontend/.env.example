# Backend API origin, read at build time by frontend/src/lib/api.js
# (Vite exposes only variables prefixed with VITE_).
#
# Local dev: leave this unset. The app falls back to http://127.0.0.1:8000,
# which is where `uvicorn api:app --reload` listens by default.
#
# Production (Vercel): set VITE_API_URL to the deployed backend's origin.
# No trailing slash, no path -- just scheme + host.
VITE_API_URL=https://your-backend.onrender.com
